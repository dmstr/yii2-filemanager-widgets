{
  "name": "dmstr/yii2-filemanager-widgets",
  "description": "A smart filemanager to manage your files in the browser, built with Vue 3 for Yii2 and Bootstrap 3",
  "type": "yii2-extension",
  "keywords": [
    "yii2",
    "filemanager",
    "vue",
    "vue3"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Christopher Stebe",
      "email": "c.stebe@herzogkommunikation.de"
    }
  ],
  "require": {
    "yiisoft/yii2": "*",
    "dmstr/yii2-filefly-module" : "^1.7.0-rc1 || ^2.0",
    "kartik-v/yii2-widget-select2": "^2.0.0",
    "rmrevin/yii2-fontawesome": "~2.9",
    "yiisoft/yii2-bootstrap": "~2.0"
  },
  "extra": {
    "bootstrap": "hrzg\\filemanager\\Bootstrap"
  },
  "suggest": {
    "pheme/yii2-settings": "Allows more advanced settings fpr e.g. FileManagerWidget"
  },
  "autoload": {
    "psr-4": {
      "hrzg\\filemanager\\": "src/"
    }
  }
}
